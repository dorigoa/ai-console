# systemd unit (Quadlet, rootless podman) that runs ai-console in a container
# on raspy: starts it at boot even without a login (lingering required) and
# restarts it if it fails. Same options as run.sh with LAN_IP=192.168.1.40.
#
# Install and update: ./install.sh (builds, copies this unit into
# ~/.config/containers/systemd and restarts the service). Port 8501 must be free.
# Logs:   journalctl --user-unit ai-console -f   (or podman logs -f ai-console)
# Shell:  podman exec -it ai-console bash

[Unit]
Description=ai-console in a podman container

[Container]
Image=localhost/pi-agent:latest
ContainerName=ai-console
# Same UID inside and outside, otherwise alvise cannot read the mounted keys.
UserNS=keep-id
# 127.0.0.1 for Tailscale serve, the wlan0 IP for the other computers on the LAN.
PublishPort=127.0.0.1:8501:8501
PublishPort=192.168.1.40:8501:8501
# Keys for GitHub and for the nodes, read-only: entrypoint.sh copies them into ~/.ssh.
Volume=%h/.ssh/id_ed25519:/run/host-ssh/github/id_ed25519:ro
Volume=%h/.ssh/id_ed25519.pub:/run/host-ssh/github/id_ed25519.pub:ro
Volume=%h/.ssh/id_ecdsa:/run/host-ssh/nodes/id_ecdsa:ro
Volume=%h/.ssh/id_ecdsa.pub:/run/host-ssh/nodes/id_ecdsa.pub:ro

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
