# Per-host settings for run.sh and build.sh: copy to run.env (not committed)
# and keep only what differs from the defaults.

# Runtime: container (macOS), podman or docker. Default: the first one found.
#RUNTIME=podman

# Image and container name.
#IMAGE=ai-console:latest
#NAME=ai-console

# ai-console on the host: always on 127.0.0.1:HOST_PORT, also on LAN_IP:HOST_PORT if set.
#HOST_PORT=8501
#LAN_IP=192.168.1.40

# Keys for the nodes (space separated), mounted when the ssh-agent cannot be forwarded.
#NODE_KEYS="$HOME/.ssh/id_ecdsa"
