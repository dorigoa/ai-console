# ai-console image: the NiceGUI console in app/, on Python 3.13 (Alpine), run
# as the host user (same name, UID and GID).
#
# Build:   container/build.sh    -> image ai-console
# Run:     container/run.sh      -> container ai-console, on http://127.0.0.1:8501
# Service: container/install.sh  -> systemd service on the gateway node (podman + Quadlet)
# The scripts use `container` on macOS and podman (or docker) on Linux.
#
# The build context is the repository root (see .dockerignore) and the image
# holds app/ as it is in the checkout: no clone from GitHub, so no GitHub key
# at build time. No SSH key goes into the image either: for the nodes managed by
# ai-console, run.sh forwards the host's ssh-agent (`container`) or mounts the
# keys read-only (podman, docker, the Quadlet unit), and entrypoint.sh copies
# them into ~/.ssh.

# Host user: build.sh passes the values from `id`.
ARG USER_NAME=alvise
ARG USER_UID=502
ARG USER_GID=20

# Fully qualified name: podman cannot resolve short names without a default registry.
FROM docker.io/library/python:3.13-alpine

# System tools, plus openssh-client (ai-console runs its commands on the nodes
# over ssh) and tini (PID 1: forwards signals and reaps child processes).
RUN apk add --no-cache \
        jq wget curl bc htop atop bzip2 git gcc g++ cmake \
        iperf iperf3 vim net-tools parallel psmisc screen stress-ng \
        bash ca-certificates openssh-client tini

ARG USER_NAME
ARG USER_UID
ARG USER_GID

# User with the same name, UID and GID as on the host. If the GID already exists
# in the image (20 is "dialout" in Alpine), the user joins that group.
RUN set -e; \
    group="$(awk -F: -v gid="$USER_GID" '$3 == gid { print $1; exit }' /etc/group)"; \
    if [ -z "$group" ]; then group="$USER_NAME"; addgroup -g "$USER_GID" "$group"; fi; \
    adduser -D -s /bin/bash -h "/home/$USER_NAME" -u "$USER_UID" -G "$group" "$USER_NAME"

# ai-console's Python dependencies: this layer is rebuilt only when requirements.txt changes.
COPY app/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY --chmod=755 container/entrypoint.sh /usr/local/bin/entrypoint.sh

USER ${USER_NAME}

# Owned by the user: ai-console writes its NiceGUI storage (.nicegui/,
# .storage_secret) next to the code.
COPY --chown=${USER_UID}:${USER_GID} app/ /home/${USER_NAME}/ai-console/
WORKDIR /home/${USER_NAME}/ai-console

# The checkout the image was built from (git describe, "-dirty" if it had
# uncommitted changes): `printenv AI_CONSOLE_VERSION` in the container.
ARG AI_CONSOLE_VERSION=unknown
LABEL org.opencontainers.image.source="https://github.com/dorigoa/ai-console" \
      org.opencontainers.image.revision="${AI_CONSOLE_VERSION}"
ENV AI_CONSOLE_VERSION=${AI_CONSOLE_VERSION} \
    PYTHONUNBUFFERED=1

# ai-console's port (UI_PORT in app/config.json, default 8501). run.sh and
# ai-console.container publish it on the host's 127.0.0.1 (where Tailscale serve
# takes it, see gateway/) and, if set, on its LAN IP.
EXPOSE 8501

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["python3", "ai-console-gui.py"]

